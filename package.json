{
  "name": "library",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "bun run next dev",
    "build": "bun run next build",
    "prebuild": "bun run covers",
    "covers": "bun run scripts/generate-covers.ts",
    "sync": "bun run scripts/sync-books.ts",
    "start": "bun run next start",
    "lint": "bun run next lint",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest",
    "test:coverage": "bun run vitest run --coverage"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "motion-dom": "11.18.1",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.0",
    "jsdom": "^24.0.0",
    "pdfjs-dist": "^6.2.108",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  }
